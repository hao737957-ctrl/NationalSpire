{
  "schemaVersion": 1,
  "part": "r",
  "lines": [
    { "tier": 1, "event": "worlds_reward", "text": "这彩头听着比比赛还刺激" },
    { "tier": 1, "event": "worlds_reward", "text": "就这奖励，是给人定的吗" },
    { "tier": 1, "event": "worlds_reward", "text": "谁拿都一样，反正轮不到我" },
    { "tier": 1, "event": "worlds_reward", "text": "奖励挺好，可惜不是给你的" },
    { "tier": 1, "event": "worlds_reward", "text": "这批奖励看一眼就够本了" },
    { "tier": 1, "event": "worlds_reward", "text": "公示一出来我就笑出声了" },
    { "tier": 1, "event": "worlds_reward", "text": "这奖励是抽奖抽出来的吧" },
    { "tier": 1, "event": "worlds_reward", "text": "想拿这彩头，先赢一场吧" },
    { "tier": 1, "event": "worlds_reward", "text": "真来个地震级的，我不意外" },
    { "tier": 1, "event": "worlds_reward", "text": "地震都安排上了，牛" },
    { "tier": 1, "event": "worlds_reward", "text": "就这彩头，也好意思叫国家级" },
    { "tier": 1, "event": "worlds_reward", "text": "真发了？我还以为是段子" },
    { "tier": 1, "event": "worlds_reward", "text": "这彩头我是真服了" },
    { "tier": 1, "event": "worlds_reward", "text": "拿了这东西，以后还怎么输" },
    { "tier": 1, "event": "worlds_reward", "text": "我说这奖励，换我我也想要" },
    { "tier": 1, "event": "worlds_reward", "text": "发到手了，弹幕都安静了" },
    { "tier": 1, "event": "worlds_reward", "text": "这一发放，全社区都活了" },
    { "tier": 1, "event": "worlds_reward", "text": "早说这奖励是真的，我信了" },
    { "tier": 1, "event": "worlds_reward", "text": "这波发奖，比比赛好看" },
    { "tier": 1, "event": "worlds_reward", "text": "实名羡慕，虽然跟我没关系" },

    { "tier": 2, "event": "worlds_reward", "text": "这彩头配他？隔壁那个不配吗" },
    { "tier": 2, "event": "worlds_reward", "text": "算算性价比，这奖励真值吗" },
    { "tier": 2, "event": "worlds_reward", "text": "国家级的东西，标准挺随意" },
    { "tier": 2, "event": "worlds_reward", "text": "公示而已，别当成已经到手" },
    { "tier": 2, "event": "worlds_reward", "text": "奖励越夸张，越显得心虚" },
    { "tier": 2, "event": "worlds_reward", "text": "拿这个当目标，格局小了点" },
    { "tier": 2, "event": "worlds_reward", "text": "我给个中肯评价，这彩头一般" },
    { "tier": 2, "event": "worlds_reward", "text": "捧了半天，奖励也不是给他的" },
    { "tier": 2, "event": "worlds_reward", "text": "放假这种事也能当奖励？" },
    { "tier": 2, "event": "worlds_reward", "text": "改日历也行，反正我不用上班" },
    { "tier": 2, "event": "worlds_reward", "text": "这批名目，写得比成绩还漂亮" },
    { "tier": 2, "event": "worlds_reward", "text": "发了就发了，别哭着要第二个" },
    { "tier": 2, "event": "worlds_reward", "text": "这奖励给他，我勉强认账" },
    { "tier": 2, "event": "worlds_reward", "text": "酸一句，这彩头确实够狠" },
    { "tier": 2, "event": "worlds_reward", "text": "承认吧，这波奖励发得漂亮" },
    { "tier": 2, "event": "worlds_reward", "text": "与其羡慕奖励，不如看成绩" },
    { "tier": 2, "event": "worlds_reward", "text": "含金量这块，奖励说明不了什么" },
    { "tier": 2, "event": "worlds_reward", "text": "换个人拿，估计早吹上天了" },
    { "tier": 2, "event": "worlds_reward", "text": "这彩头够他吹一辈子了" },
    { "tier": 2, "event": "worlds_reward", "text": "说到底，还是成绩换来的" },

    { "tier": 3, "event": "worlds_reward", "text": "这奖励本来就是{name}的" },
    { "tier": 3, "event": "worlds_reward", "text": "别人别惦记这份名目了" },
    { "tier": 3, "event": "worlds_reward", "text": "{name}夺冠，这彩头才配得上" },
    { "tier": 3, "event": "worlds_reward", "text": "对面拿这奖励？想都别想" },
    { "tier": 3, "event": "worlds_reward", "text": "公示就是给{name}预热" },
    { "tier": 3, "event": "worlds_reward", "text": "这彩头写着{name}的名字" },
    { "tier": 3, "event": "worlds_reward", "text": "谁惦记这奖励，先赢{name}再说" },
    { "tier": 3, "event": "worlds_reward", "text": "{country}的排面，奖励也是" },
    { "tier": 3, "event": "worlds_reward", "text": "{name}拿了，全国放假一天" },
    { "tier": 3, "event": "worlds_reward", "text": "{club}跟着沾光了吧" },
    { "tier": 3, "event": "worlds_reward", "text": "发了发了，{name}的国运级赏赐" },
    { "tier": 3, "event": "worlds_reward", "text": "这彩头到手，黑子该闭嘴了" },
    { "tier": 3, "event": "worlds_reward", "text": "{name}拿走这奖励，天经地义" },
    { "tier": 3, "event": "worlds_reward", "text": "隔壁那位只能看着眼红" },
    { "tier": 3, "event": "worlds_reward", "text": "别人拿叫运气，{name}拿叫应该" },
    { "tier": 3, "event": "worlds_reward", "text": "这波发奖，顺带把黑子清了" },
    { "tier": 3, "event": "worlds_reward", "text": "{rival}连边都摸不着" },
    { "tier": 3, "event": "worlds_reward", "text": "谁不服这奖励，出来说" },
    { "tier": 3, "event": "worlds_reward", "text": "国运级赏赐，只能是他" },
    { "tier": 3, "event": "worlds_reward", "text": "奖励在手，历史在前" },

    { "tier": 4, "event": "worlds_reward", "text": "这奖励该进档案，不是给谁的" },
    { "tier": 4, "event": "worlds_reward", "text": "公示这批名目，标准得写清楚" },
    { "tier": 4, "event": "worlds_reward", "text": "拿不到就是拿不到，别找理由" },
    { "tier": 4, "event": "worlds_reward", "text": "这彩头是刻度，量的是成绩" },
    { "tier": 4, "event": "worlds_reward", "text": "国家级赏赐，只认最后的结果" },
    { "tier": 4, "event": "worlds_reward", "text": "奖励公示那天，历史就开始了" },
    { "tier": 4, "event": "worlds_reward", "text": "改日历这种奖励，够狠" },
    { "tier": 4, "event": "worlds_reward", "text": "只有冠军配谈这份名目" },
    { "tier": 4, "event": "worlds_reward", "text": "这批名目的分量，懂的人懂" },
    { "tier": 4, "event": "worlds_reward", "text": "开赛前的公示，就是在立刻度" },
    { "tier": 4, "event": "worlds_reward", "text": "发放这一刻，历史就算写完了" },
    { "tier": 4, "event": "worlds_reward", "text": "他拿了这份名目，标准就抬高了" },
    { "tier": 4, "event": "worlds_reward", "text": "别人拿了不算数，我说真的" },
    { "tier": 4, "event": "worlds_reward", "text": "这份名目进史书，我作证" },
    { "tier": 4, "event": "worlds_reward", "text": "国家级的彩头，配得上这成绩" },
    { "tier": 4, "event": "worlds_reward", "text": "发到手，这代人就封顶了" },
    { "tier": 4, "event": "worlds_reward", "text": "旧神们可没领过这种东西" },
    { "tier": 4, "event": "worlds_reward", "text": "只认结果，奖励就是证明" },
    { "tier": 4, "event": "worlds_reward", "text": "拿到这份名目，就该封神了" },
    { "tier": 4, "event": "worlds_reward", "text": "这刻度一立，后来人别想超" }
  ]
}
